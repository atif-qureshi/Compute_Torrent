# Copy this file to .env and replace all values with unique random hex strings.
# These values are secrets. Do not commit the generated .env file.
POSTGRES_PASSWORD=replace_with_random_hex
COMPUTETORRENT_API_TOKEN=replace_with_a_different_random_hex
COMPUTETORRENT_SEEDER_ENROLLMENT_TOKEN=replace_with_another_random_hex
COMPUTETORRENT_PORTAL_PASSWORD=replace_with_a_long_private_password
COMPUTETORRENT_SESSION_SECRET=replace_with_at_least_64_random_hex_characters
COMPUTETORRENT_COOKIE_SECURE=false
COMPUTETORRENT_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:light
COMPUTETORRENT_LLAMA_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:full-cuda
WEBTORRENT_TRACKERS=wss://tracker.openwebtorrent.com,wss://tracker.webtorrent.dev
COMPUTETORRENT_CANARY_PERCENT=10

# Local trusted-LAN setup. Set ADVERTISE_HOST to this coordinator PC's private
# IPv4 address. Keep these services off the public internet.
COMPUTETORRENT_PORTAL_BIND_IP=0.0.0.0
COMPUTETORRENT_BIND_IP=0.0.0.0
COMPUTETORRENT_LIBP2P_BIND_IP=0.0.0.0
COMPUTETORRENT_LIBP2P_ADVERTISE_HOST=192.168.1.5

# Optional hybrid control endpoints. Learn alternatives only from this coordinator.
# Examples are not deployed. Keep [] until the operator configures real endpoints.
COMPUTETORRENT_PROVIDER_ENDPOINTS=[]
COMPUTETORRENT_PETALS_NETWORK_POLICY=auto
# Certificate-verified public ingress path for the gateway's WSS byte broker.
# Empty keeps public relay hosting disabled in an ordinary local-only setup.
PETALS_RELAY_PUBLIC_URL=
